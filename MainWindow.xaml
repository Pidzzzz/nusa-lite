<Window x:Class="NusaLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NusaLite.Controls"
        Title="NusaLite"
        Width="760"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        Loaded="Window_Loaded"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <Grid x:Name="Root" Background="Transparent">
        <StackPanel x:Name="Stack" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
            <Grid x:Name="IslandHost" Width="198" Height="34" HorizontalAlignment="Center"
                  MouseLeftButtonDown="Island_MouseLeftButtonDown"
                  MouseLeftButtonUp="Island_MouseLeftButtonUp"
                  MouseWheel="Island_MouseWheel">
                <controls:NotchShape x:Name="Notch" Fill="#FF000000" CornerRadius="12" EarRadius="0" />
                <ContentControl x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Focusable="False" IsTabStop="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentSlide" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <Border x:Name="DotsBar" Margin="0,6,0,0" HorizontalAlignment="Center" Background="#99070A12"
                    CornerRadius="8" Padding="7,4" Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DotsSlide" />
                </Border.RenderTransform>
                <StackPanel x:Name="DotsPanel" Orientation="Horizontal" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
