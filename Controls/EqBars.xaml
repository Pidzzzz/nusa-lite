<UserControl x:Class="NusaLite.Controls.EqBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="13" IsHitTestVisible="False">
    <UserControl.Resources>
        <Storyboard x:Key="EqStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bar1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.28" To="1" Duration="0:0:0.92" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.32" Duration="0:0:1.12" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar3"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.42" To="1" Duration="0:0:0.84" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar4"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="0.38" Duration="0:0:1.04" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Bar5"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.34" To="0.94" Duration="0:0:0.96" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EqStoryboard}" />
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle x:Name="Bar1" Grid.Column="0" Width="2.2" Height="12" VerticalAlignment="Bottom"
                   RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource EqBrush}" Opacity="0.94"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="0.5" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Bar2" Grid.Column="1" Width="2.2" Height="12" VerticalAlignment="Bottom"
                   RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource EqBrush}" Opacity="0.94"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="0.8" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Bar3" Grid.Column="2" Width="2.2" Height="12" VerticalAlignment="Bottom"
                   RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource EqBrush}" Opacity="0.94"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="0.6" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Bar4" Grid.Column="3" Width="2.2" Height="12" VerticalAlignment="Bottom"
                   RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource EqBrush}" Opacity="0.94"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="0.4" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="Bar5" Grid.Column="4" Width="2.2" Height="12" VerticalAlignment="Bottom"
                   RadiusX="1.1" RadiusY="1.1" Fill="{StaticResource EqBrush}" Opacity="0.94"
                   RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleY="0.7" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
