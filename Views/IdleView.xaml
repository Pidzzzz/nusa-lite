<UserControl x:Class="NusaLite.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls">
    <Grid Margin="12,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" ClipToBounds="True" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="OpacityMask" Value="{x:Null}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PomodoroActive}" Value="True">
                            <Setter Property="OpacityMask">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF000000" />
                                        <GradientStop Offset="0.88" Color="#FF000000" />
                                        <GradientStop Offset="1" Color="#00000000" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

        <Path Data="{StaticResource IconBolt}" Fill="{DynamicResource MintBrush}" Width="9" Height="9" Stretch="Uniform"
              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
              Visibility="{Binding IsCharging, Converter={StaticResource BoolVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAltHint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Path Width="14" Height="14" Stretch="Uniform"
                  Margin="0,0,8,0" VerticalAlignment="Center"
                  Visibility="{Binding HasSourceIcon, Converter={StaticResource BoolVis}}">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Data" Value="{StaticResource IconMusicNote}" />
                        <Setter Property="Fill" Value="{DynamicResource MistBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SourceIconKey}" Value="Spotify">
                                <Setter Property="Data" Value="{StaticResource IconSpotify}" />
                                <Setter Property="Fill" Value="#1DB954" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SourceIconKey}" Value="YouTubeMusic">
                                <Setter Property="Data" Value="{StaticResource IconYouTubeMusic}" />
                                <Setter Property="Fill" Value="#FF0000" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SourceIconKey}" Value="YouTube">
                                <Setter Property="Data" Value="{StaticResource IconYouTube}" />
                                <Setter Property="Fill" Value="#FF0000" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SourceIconKey}" Value="Browser">
                                <Setter Property="Data" Value="{StaticResource IconGlobe}" />
                                <Setter Property="Fill" Value="#4C8DFF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SourceIconKey}" Value="Media">
                                <Setter Property="Data" Value="{StaticResource IconMusicNote}" />
                                <Setter Property="Fill" Value="{DynamicResource MistBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>

            <controls:LyricTicker Current="{Binding IdleLine}" FontSize="13.5" Height="19"
                                  FontWeight="Medium" Foreground="{DynamicResource InkBrush}"
                                  MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowAltHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Tahan" FontFamily="{StaticResource UiFont}" FontSize="10"
                       Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource AccentTint40Brush}" BorderThickness="1"
                    CornerRadius="4,3,4,3" Padding="4,0" VerticalAlignment="Center">
                <TextBlock Text="Alt" FontFamily="{StaticResource UiFont}" FontSize="10"
                           Foreground="{DynamicResource InkBrush}" />
            </Border>
            <TextBlock Text="untuk membuka" FontFamily="{StaticResource UiFont}" FontSize="10"
                       Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <controls:EqBars Width="16" Height="14" VerticalAlignment="Center" IsHitTestVisible="False"
                             Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />

            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource RoseBrush}" VerticalAlignment="Center"
                     IsHitTestVisible="False">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasMedia}" Value="True" />
                                    <Condition Binding="{Binding IsPlaying}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <Button x:Name="FocusChip" Click="FocusChip_Click" Cursor="Hand" Focusable="False"
                    VerticalAlignment="Center" Margin="12,0,0,0"
                    ToolTip="Timer Fokus — klik untuk membuka"
                    Visibility="{Binding PomodoroActive, Converter={StaticResource BoolVis}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0.75" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PomodoroRunning}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <controls:ArcRing Width="14" Height="14" Percent="{Binding PomodoroProgress}" Thickness="2"
                                      VerticalAlignment="Center"
                                      TrackBrush="{DynamicResource RingTrackBrush}">
                        <controls:ArcRing.RenderTransform>
                            <TranslateTransform Y="-1" />
                        </controls:ArcRing.RenderTransform>
                        <controls:ArcRing.Style>
                            <Style TargetType="controls:ArcRing">
                                <Setter Property="Stroke" Value="{DynamicResource EmberBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource MintBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:ArcRing.Style>
                    </controls:ArcRing>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="1" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                                <Setter Property="FontSize" Value="9" />
                                <Setter Property="LineHeight" Value="11" />
                                <Setter Property="FontWeight" Value="{DynamicResource MicroTextWeight}" />
                                <Setter Property="Text" Value="F&#x200A;O&#x200A;K&#x200A;U&#x200A;S" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                        <Setter Property="Text" Value="I&#x200A;S&#x200A;T&#x200A;I&#x200A;R&#x200A;A&#x200A;H&#x200A;A&#x200A;T" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource TinyText}" FontSize="12" LineHeight="15"
                               Text="{Binding PomodoroTime}" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform Y="0.5" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
