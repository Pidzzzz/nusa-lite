<UserControl x:Class="NusaLite.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             IsHitTestVisible="False">
    <Grid Margin="12,0,12,0">
        <Path Data="{StaticResource IconBolt}" Fill="{StaticResource MintBrush}" Width="9" Height="9" Stretch="Uniform"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              Visibility="{Binding IsCharging, Converter={StaticResource BoolVis}}" />

        <controls:LyricTicker Current="{Binding IdleLine}" FontSize="10.5" Height="15"
                              MaxWidth="288" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:LyricTicker.Style>
                <Style TargetType="controls:LyricTicker">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAltHint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:LyricTicker.Style>
        </controls:LyricTicker>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowAltHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Tahan" FontFamily="{StaticResource UiFont}" FontSize="10"
                       Foreground="{StaticResource MistBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <Border Background="#26CDB4FF" BorderBrush="#40CDB4FF" BorderThickness="1"
                    CornerRadius="4,3,4,3" Padding="4,0" VerticalAlignment="Center">
                <TextBlock Text="Alt" FontFamily="{StaticResource UiFont}" FontSize="8.5"
                           Foreground="{StaticResource InkBrush}" />
            </Border>
            <TextBlock Text="untuk membuka" FontFamily="{StaticResource UiFont}" FontSize="10"
                       Foreground="{StaticResource MistBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>

        <controls:EqBars Width="17" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />

        <Ellipse Width="4.5" Height="4.5" Fill="{StaticResource RoseBrush}" HorizontalAlignment="Right"
                 VerticalAlignment="Center">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasMedia}" Value="True" />
                                <Condition Binding="{Binding IsPlaying}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
    </Grid>
</UserControl>
