<UserControl x:Class="NusaLite.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="360" Height="142">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="LyricsFadeTopBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{DynamicResource VoidColor}" />
            <GradientStop Offset="1" Color="Transparent" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LyricsFadeBottomBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="1" Color="{DynamicResource VoidColor}" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="ArtColumn" Width="56" VerticalAlignment="Center">
            <Grid x:Name="ArtBox" Width="40" Height="40" HorizontalAlignment="Left">
                <Grid.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.28" />
                </Grid.Effect>
                <Border x:Name="ArtPlaceholder" CornerRadius="10" Background="{DynamicResource AccentDiagonalBrush}"
                        Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolVis}}">
                    <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextFaintBrush}" Width="18" Height="18" Stretch="Uniform" Opacity="0.92" />
                </Border>
                <Border x:Name="ArtImage" CornerRadius="10">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="ArtOutline" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineSoft1FBrush}" />
            </Grid>
        </StackPanel>

        <Border x:Name="Divider" Grid.Column="1" Width="1" Background="{DynamicResource AmberBrush}" Opacity="0.2"
                Margin="0,4,16,4" />

        <Grid x:Name="LyricHost" Grid.Column="2" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <controls:ScrollingText x:Name="TitleLine" Text="{Binding TrackTitle}"
                                            FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                            FontWeight="SemiBold" LineHeight="18"
                                            Foreground="{DynamicResource InkBrush}" />
                    <TextBlock x:Name="ArtistLine" Text="{Binding TrackArtist}" Style="{StaticResource TinyText}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid x:Name="FocusChipHost" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="FocusChip" Click="FocusChip_Click" Cursor="Hand" Focusable="False"
                            ToolTip="Timer Fokus — klik untuk membuka"
                            Visibility="{Binding PomodoroActive, Converter={StaticResource BoolVis}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PomodoroRunning}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ChipBorder" CornerRadius="999"
                                        Background="{DynamicResource SoftFillBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Padding="6,3">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <controls:ArcRing Width="16" Height="16" Percent="{Binding PomodoroProgress}" Thickness="2"
                                              TrackBrush="{DynamicResource TrackSoft20Brush}">
                                <controls:ArcRing.Style>
                                    <Style TargetType="controls:ArcRing">
                                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource MintBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:ArcRing.Style>
                            </controls:ArcRing>
                            <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                                            <Setter Property="FontSize" Value="9" />
                                            <Setter Property="LineHeight" Value="11" />
                                            <Setter Property="Opacity" Value="0.85" />
                                            <Setter Property="Text" Value="F&#x200A;O&#x200A;K&#x200A;U&#x200A;S" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                                    <Setter Property="Text" Value="I&#x200A;S&#x200A;T&#x200A;I&#x200A;R&#x200A;A&#x200A;H&#x200A;A&#x200A;T" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource TinyText}" FontSize="10"
                                           Text="{Binding PomodoroTime}" Typography.NumeralAlignment="Tabular"
                                           HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" ClipToBounds="True">
                <StackPanel VerticalAlignment="Top">
                    <controls:ScrollingText x:Name="PrevLine" Text="{Binding LyricPrev}"
                                            FontFamily="{StaticResource UiFont}" FontSize="13" LineHeight="18"
                                            Foreground="{DynamicResource InkBrush}" Opacity="0.40" />
                    <Grid x:Name="ActiveLineHost">
                        <Border x:Name="ActiveGlow" Margin="-8,0" CornerRadius="16"
                                Background="{DynamicResource LyricsGlowFillBrush}"
                                BorderBrush="{DynamicResource LyricsGlowBorderBrush}" BorderThickness="1"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentShadowColor}" BlurRadius="24"
                                                  ShadowDepth="0" Opacity="0.2" />
                            </Border.Effect>
                        </Border>
                        <controls:ScrollingText x:Name="CurrentLine" Text="{Binding LyricCurrent}"
                                                FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                                FontWeight="SemiBold" LineHeight="19"
                                                Foreground="{DynamicResource LyricsActiveBrush}"
                                                Margin="0" />
                    </Grid>
                    <controls:ScrollingText x:Name="NextLine" Text="{Binding LyricNext}"
                                            FontFamily="{StaticResource UiFont}" FontSize="13" LineHeight="18"
                                            Foreground="{DynamicResource InkBrush}" Opacity="0.50" />
                </StackPanel>

                <Rectangle x:Name="FadeTop" Height="40" VerticalAlignment="Top" Fill="{StaticResource LyricsFadeTopBrush}"
                           IsHitTestVisible="False" />
                <Rectangle x:Name="FadeBottom" Height="40" VerticalAlignment="Bottom" Fill="{StaticResource LyricsFadeBottomBrush}"
                           IsHitTestVisible="False" />
            </Grid>

            <StackPanel x:Name="OffsetPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="18" Height="16" Click="OffsetMinus_Click"
                        ToolTip="Lirik lebih cepat">
                    <Path Data="{StaticResource IconMinus}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                </Button>
                <TextBlock Text="{Binding LyricOffsetText}" Style="{StaticResource TinyText}" FontSize="10"
                           Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0" />
                <Button Style="{StaticResource IconButton}" Width="18" Height="16" Click="OffsetPlus_Click"
                        ToolTip="Lirik lebih lambat">
                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                </Button>
            </StackPanel>

            <Border x:Name="MessagePanel" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" CornerRadius="16"
                    Padding="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowLyricsMessage, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconLyrics}" Style="{StaticResource StrokeIcon}" Width="14" Height="14"
                          Opacity="0.6" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding LyricsMessage}" Style="{StaticResource CaptionText}" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
