<UserControl x:Class="NusaLite.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="108">
    <Grid Margin="14,10,14,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="ArtColumn" Width="66" VerticalAlignment="Center">
            <Grid x:Name="ArtBox" Width="56" Height="56" HorizontalAlignment="Left">
                <Grid.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.28" />
                </Grid.Effect>
                <Border x:Name="ArtPlaceholder" CornerRadius="16" Background="{DynamicResource AccentDiagonalBrush}"
                        Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolVis}}">
                    <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextFaintBrush}" Width="22" Height="22" Stretch="Uniform" Opacity="0.92" />
                </Border>
                <Border x:Name="ArtImage" CornerRadius="16">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="ArtOutline" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource LineSoft1FBrush}" />
            </Grid>
            <TextBlock x:Name="TitleLine" Text="{Binding TrackTitle}" Style="{StaticResource TitleText}" FontSize="10.5"
                       Margin="0,6,0,0" MaxWidth="66" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ArtistLine" Text="{Binding TrackArtist}" Style="{StaticResource TinyText}" FontSize="10"
                       Margin="0,2,0,0" MaxWidth="66" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border x:Name="Divider" Grid.Column="1" Width="1" Background="{DynamicResource AmberBrush}" Opacity="0.4"
                Margin="0,2,12,2" />

        <Grid x:Name="LyricHost" Grid.Column="2" Margin="14,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                <TextBlock x:Name="PrevLine" Text="{Binding LyricPrev}" Style="{StaticResource BaseText}" FontSize="11"
                           Foreground="{DynamicResource TextGhost59Brush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CurrentLine" Text="{Binding LyricCurrent}" Style="{StaticResource TitleText}"
                           FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19"
                           MaxHeight="38" Margin="0,3,0,3" />
                <TextBlock x:Name="NextLine" Text="{Binding LyricNext}" Style="{StaticResource BaseText}" FontSize="11"
                           Foreground="{DynamicResource TextGhost59Brush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="OffsetPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="18" Height="16" Click="OffsetMinus_Click"
                        ToolTip="Lirik lebih cepat">
                    <Path Data="{StaticResource IconMinus}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                </Button>
                <TextBlock Text="{Binding LyricOffsetText}" Style="{StaticResource TinyText}" FontSize="8.5"
                           Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="1,0" />
                <Button Style="{StaticResource IconButton}" Width="18" Height="16" Click="OffsetPlus_Click"
                        ToolTip="Lirik lebih lambat">
                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                </Button>
            </StackPanel>

            <Border x:Name="MessagePanel" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" CornerRadius="12"
                    Padding="14,8" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowLyricsMessage, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconLyrics}" Style="{StaticResource StrokeIcon}" Width="14" Height="14"
                          Opacity="0.6" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding LyricsMessage}" Style="{StaticResource CaptionText}" FontSize="10.5" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
