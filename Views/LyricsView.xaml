<UserControl x:Class="NusaLite.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="360" Height="142">
    <Grid x:Name="Root" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="ArtColumn" Width="66" VerticalAlignment="Center">
            <Grid x:Name="ArtBox" Width="56" Height="56" HorizontalAlignment="Left">
                <Grid.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.28" />
                </Grid.Effect>
                <Border x:Name="ArtPlaceholder" CornerRadius="8" Background="{DynamicResource AccentDiagonalBrush}"
                        Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolVis}}">
                    <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextFaintBrush}" Width="22" Height="22" Stretch="Uniform" Opacity="0.92" />
                </Border>
                <Border x:Name="ArtImage" CornerRadius="8">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border x:Name="ArtOutline" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineSoft1FBrush}" />
            </Grid>
        </StackPanel>

        <Border x:Name="Divider" Grid.Column="1" Width="1" Background="{DynamicResource AmberBrush}" Opacity="0.4"
                Margin="0,4,16,4" />

        <Grid x:Name="LyricHost" Grid.Column="2" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <controls:MarqueeText x:Name="TitleLine" Text="{Binding TrackTitle}"
                                      FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                      FontWeight="SemiBold" LineHeight="19"
                                      Foreground="{DynamicResource InkBrush}" />
                <TextBlock x:Name="ArtistLine" Text="{Binding TrackArtist}" Style="{StaticResource TinyText}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <controls:MarqueeText x:Name="PrevLine" Text="{Binding LyricPrev}"
                                      FontFamily="{StaticResource UiFont}" FontSize="13" LineHeight="18"
                                      Foreground="{DynamicResource TextGhost59Brush}" />
                <controls:MarqueeText x:Name="CurrentLine" Text="{Binding LyricCurrent}"
                                      FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                      FontWeight="SemiBold" LineHeight="19"
                                      Foreground="{DynamicResource InkBrush}"
                                      Margin="0" />
                <controls:MarqueeText x:Name="NextLine" Text="{Binding LyricNext}"
                                      FontFamily="{StaticResource UiFont}" FontSize="13" LineHeight="18"
                                      Foreground="{DynamicResource TextGhost59Brush}" />
            </StackPanel>

            <StackPanel x:Name="OffsetPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Width="18" Height="16" Click="OffsetMinus_Click"
                        ToolTip="Lirik lebih cepat">
                    <Path Data="{StaticResource IconMinus}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                </Button>
                <TextBlock Text="{Binding LyricOffsetText}" Style="{StaticResource TinyText}" FontSize="10"
                           Foreground="{DynamicResource AmberBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0" />
                <Button Style="{StaticResource IconButton}" Width="18" Height="16" Click="OffsetPlus_Click"
                        ToolTip="Lirik lebih lambat">
                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource StrokeIcon}" Width="9" Height="9" />
                </Button>
            </StackPanel>

            <Border x:Name="MessagePanel" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" CornerRadius="16"
                    Padding="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding ShowLyricsMessage, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconLyrics}" Style="{StaticResource StrokeIcon}" Width="14" Height="14"
                          Opacity="0.6" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding LyricsMessage}" Style="{StaticResource CaptionText}" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
