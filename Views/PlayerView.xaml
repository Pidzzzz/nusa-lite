<UserControl x:Class="NusaLite.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="512" Height="158">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="108" Height="108" VerticalAlignment="Top">
            <Grid.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="28" ShadowDepth="0" Opacity="0.32" />
            </Grid.Effect>
            <Border CornerRadius="16" Background="{DynamicResource AccentDiagonalBrush}"
                    Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolVis}}">
                <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextFaintBrush}" Width="40" Height="40" Stretch="Uniform" Opacity="0.92" />
            </Border>
            <Border CornerRadius="16">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource LineSoft1FBrush}" />
        </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource TitleText}" FontSize="15" />
                <controls:EqBars Grid.Column="1" Width="16" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PlayerFocusChip" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TrackArtist}" Style="{StaticResource CaptionText}" FontSize="11" />

                <Button x:Name="FocusChip" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                        Click="FocusChip_Click" Cursor="Hand" Focusable="False"
                        ToolTip="Timer Fokus — klik untuk membuka"
                        Visibility="{Binding PomodoroActive, Converter={StaticResource BoolVis}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.75" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PomodoroRunning}" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <controls:ArcRing Width="13" Height="13" Percent="{Binding PomodoroProgress}" Thickness="1.5"
                                          VerticalAlignment="Center"
                                          TrackBrush="{DynamicResource TrackSoft20Brush}">
                            <controls:ArcRing.Style>
                                <Style TargetType="controls:ArcRing">
                                    <Setter Property="Stroke" Value="{DynamicResource EmberBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource MintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:ArcRing.Style>
                        </controls:ArcRing>
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                                    <Setter Property="FontSize" Value="9" />
                                    <Setter Property="LineHeight" Value="11" />
                                    <Setter Property="FontWeight" Value="{DynamicResource MicroTextWeight}" />
                                    <Setter Property="Text" Value="F&#x200A;O&#x200A;K&#x200A;U&#x200A;S" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                            <Setter Property="Text" Value="I&#x200A;S&#x200A;T&#x200A;I&#x200A;R&#x200A;A&#x200A;H&#x200A;A&#x200A;T" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource TinyText}" FontSize="12.5" LineHeight="15"
                                   Text="{Binding PomodoroTime}" Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PlayerFocusChip" />
                </Grid.ColumnDefinitions>
                <controls:LyricTicker Current="{Binding LyricCurrent}" Height="16" FontSize="12"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasLyrics, Converter={StaticResource BoolVis}}" />
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,0,0,0">
                <Grid x:Name="SeekArea" Height="13" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="SeekArea_MouseLeftButtonDown"
                      MouseMove="SeekArea_MouseMove"
                      MouseLeftButtonUp="SeekArea_MouseLeftButtonUp">
                    <ProgressBar Style="{StaticResource SlimProgress}" VerticalAlignment="Center"
                                 Value="{Binding TrackProgress, Mode=OneWay}" />
                </Grid>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource TinyText}" FontSize="10" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource TinyText}"
                               FontSize="10" HorizontalAlignment="Right" />
                </DockPanel>
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="Previous_Click"
                            ToolTip="Sebelumnya">
                        <Path Data="{StaticResource IconPrev}" Style="{StaticResource FillIcon}" Width="15" Height="15" />
                    </Button>
                    <Button Style="{StaticResource PlayButton}" Margin="8,0" Click="Play_Click" ToolTip="Putar / jeda">
                        <Grid Width="16" Height="16">
                            <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource OnPrimaryBrush}" Width="13" Height="13" Stretch="Uniform"
                                  Margin="1,0,0,0" Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolVis}}" />
                            <Path Data="{StaticResource IconPause}" Fill="{DynamicResource OnPrimaryBrush}" Width="11" Height="11" Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Click="Next_Click"
                            ToolTip="Berikutnya">
                        <Path Data="{StaticResource IconNext}" Style="{StaticResource FillIcon}" Width="15" Height="15" />
                    </Button>

                    <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" Margin="12,0" />

                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="Mute_Click" ToolTip="Bisu">
                        <Grid>
                            <Path Data="{StaticResource IconVolume}" Style="{StaticResource StrokeIcon}" Width="15" Height="15"
                                  Visibility="{Binding IsMuted, Converter={StaticResource InvBoolVis}}" />
                            <Path Data="{StaticResource IconMute}" Style="{StaticResource StrokeIcon}" Width="15" Height="15"
                                  Visibility="{Binding IsMuted, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </Button>
                    <Slider Width="66" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SlimSlider}"
                            Minimum="0" Maximum="100" Value="{Binding VolumeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource AccentTint12Brush}"
                        BorderBrush="{DynamicResource AccentTint2EBrush}" BorderThickness="1" CornerRadius="9" Padding="8,4">
                    <TextBlock Text="{Binding TrackSource}" Style="{StaticResource TinyText}" FontSize="10"
                               Foreground="{DynamicResource AmberBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
