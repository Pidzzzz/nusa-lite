<UserControl x:Class="NusaLite.Views.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="380" Height="88">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Width="94">
            <TextBlock Text="{Binding ClockText}" Style="{StaticResource BigText}" FontSize="18" />
            <controls:ScrollingText Text="{Binding DateText}" Margin="0,4,0,0"
                                   FontFamily="{StaticResource UiFont}" FontSize="11" LineHeight="15"
                                   Foreground="{DynamicResource MistBrush}" />
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource LineBrush}" Margin="16,4,16,4" />

        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="44" Height="44" VerticalAlignment="Center">
                <Grid.Effect>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.3" />
                </Grid.Effect>
                <Border CornerRadius="12" Background="{DynamicResource AccentDiagonalBrush}"
                        Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolVis}}">
                    <Path Data="{StaticResource IconMusic}" Fill="{DynamicResource TextFaintBrush}" Width="20" Height="20" Stretch="Uniform" Opacity="0.95" />
                </Border>
                <Border CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource TitleText}" FontSize="15"
                               MaxWidth="140" />
                    <controls:EqBars DockPanel.Dock="Right" Margin="8,0,0,0" Width="16" Height="14"
                                     Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />
                </DockPanel>
                <controls:ScrollingText Text="{Binding TrackArtist}" Margin="0,4,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="11" LineHeight="15"
                                       Foreground="{DynamicResource MistBrush}" />
                <Grid Margin="0,4,0,0" Height="12">
                    <TextBlock Text="{Binding TrackSource}" Style="{StaticResource TinyText}" FontSize="10"
                               Visibility="{Binding HasLyrics, Converter={StaticResource InvBoolVis}}" />
                    <controls:LyricTicker Current="{Binding LyricCurrent}" FontSize="11" Height="14"
                                          MaxWidth="150" HorizontalAlignment="Left"
                                          Visibility="{Binding HasLyrics, Converter={StaticResource BoolVis}}" />
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Grid Width="36" Height="36">
                <controls:ArcRing Percent="{Binding BatteryProgress}" Thickness="3.2" TrackBrush="{DynamicResource TrackSoft20Brush}">
                    <controls:ArcRing.Style>
                        <Style TargetType="controls:ArcRing">
                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource MintBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:ArcRing.Style>
                </controls:ArcRing>
                <TextBlock Text="{Binding BatteryText}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding BatteryStateText}" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                        <Setter Property="FontSize" Value="10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource MintBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
