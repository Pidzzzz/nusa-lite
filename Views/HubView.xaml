<UserControl x:Class="NusaLite.Views.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="380" Height="88">
    <Grid Margin="18,12,18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Width="94">
            <TextBlock Text="{Binding ClockText}" Style="{StaticResource BigText}" FontSize="25" />
            <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}" Margin="1,3,0,0" />
        </StackPanel>

        <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" Margin="12,2,16,2" />

        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="44" Height="44" VerticalAlignment="Center">
                <Border CornerRadius="13" Background="{StaticResource AccentDiagonalBrush}"
                        Visibility="{Binding HasArtwork, Converter={StaticResource InvBoolVis}}">
                    <Path Data="{StaticResource IconMusic}" Fill="White" Width="20" Height="20" Stretch="Uniform" Opacity="0.95" />
                </Border>
                <Border CornerRadius="13">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding TrackTitle}" Style="{StaticResource TitleText}" FontSize="13"
                               MaxWidth="140" />
                    <controls:EqBars DockPanel.Dock="Right" Margin="7,0,0,0" Width="16" Height="11"
                                     Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />
                </DockPanel>
                <TextBlock Text="{Binding TrackArtist}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                           MaxWidth="182" />
                <Grid Margin="0,1,0,0" Height="12">
                    <TextBlock Text="{Binding TrackSource}" Style="{StaticResource TinyText}" FontSize="9"
                               Visibility="{Binding HasLyrics, Converter={StaticResource InvBoolVis}}" />
                    <controls:LyricTicker Current="{Binding LyricCurrent}" FontSize="9" Height="12"
                                          MaxWidth="150" HorizontalAlignment="Left"
                                          Visibility="{Binding HasLyrics, Converter={StaticResource BoolVis}}" />
                </Grid>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Grid Width="36" Height="36">
                <controls:ArcRing Percent="{Binding BatteryProgress}" Thickness="3.2" TrackBrush="#22FFFFFF">
                    <controls:ArcRing.Style>
                        <Style TargetType="controls:ArcRing">
                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource MintBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:ArcRing.Style>
                </controls:ArcRing>
                <TextBlock Text="{Binding BatteryText}" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding BatteryStateText}" HorizontalAlignment="Center" Margin="0,3,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                        <Setter Property="FontSize" Value="8.5" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
