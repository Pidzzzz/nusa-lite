<UserControl x:Class="NusaLite.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="512" Height="158">
    <UserControl.Resources>
        <DropShadowEffect x:Key="FocusGlow" Color="#FF5A6E" BlurRadius="18" ShadowDepth="0" Opacity="0.28" />
        <DropShadowEffect x:Key="BreakGlow" Color="#6FE7D2" BlurRadius="18" ShadowDepth="0" Opacity="0.26" />
    </UserControl.Resources>
    <Grid Margin="16,14,16,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="122" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="112" Height="112" VerticalAlignment="Top">
            <controls:ArcRing Percent="{Binding PomodoroProgress}" Thickness="9" TrackBrush="#20FFFFFF">
                <controls:ArcRing.Style>
                    <Style TargetType="controls:ArcRing">
                        <Setter Property="Stroke" Value="{StaticResource EmberBrush}" />
                        <Setter Property="Effect" Value="{StaticResource FocusGlow}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource MintBrush}" />
                                <Setter Property="Effect" Value="{StaticResource BreakGlow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:ArcRing.Style>
            </controls:ArcRing>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding PomodoroTime}" Style="{StaticResource BigText}" FontSize="23"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PomodoroPhaseLabel}" Style="{StaticResource TinyText}" FontSize="9.5"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="22,2,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <TextBlock Text="Sesi fokus" Style="{StaticResource TitleText}" FontSize="16" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding PomodoroSessions}" Style="{StaticResource TinyText}"
                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Grid.Row="1" Text="{Binding PomodoroDuration}" Style="{StaticResource CaptionText}"
                       Margin="0,3,0,0" FontSize="11" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource PrimaryButton}" Width="86" Height="30" Padding="0"
                        FontSize="11.5" Click="Start_Click">
                    <TextBlock Text="{Binding PomodoroStartLabel}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="8,0,0,0"
                        Click="Reset_Click" ToolTip="Atur ulang">
                    <Path Data="{StaticResource IconReset}" Style="{StaticResource StrokeIcon}" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="2,0,0,0"
                        Click="Skip_Click" ToolTip="Lewati sesi">
                    <Path Data="{StaticResource IconSkip}" Style="{StaticResource FillIcon}" Width="14" Height="14" />
                </Button>

                <Rectangle Width="1" Height="16" Fill="{StaticResource LineBrush}" Margin="12,0" />

                <TextBlock Text="Tetap fokus, satu sesi demi satu sesi." Style="{StaticResource TinyText}"
                           FontSize="9" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
