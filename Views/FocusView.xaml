<UserControl x:Class="NusaLite.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="512" Height="158">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="104" Height="104" VerticalAlignment="Center">
            <controls:ArcRing Percent="{Binding PomodoroProgress}" Thickness="7"
                              TrackBrush="{DynamicResource RingTrackBrush}">
                <controls:ArcRing.Style>
                    <Style TargetType="controls:ArcRing">
                        <Setter Property="Stroke" Value="{DynamicResource EmberBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource MintBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:ArcRing.Style>
            </controls:ArcRing>
            <TextBlock Text="{Binding PomodoroTime}"
                       FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Normal"
                       LineHeight="32" Typography.NumeralAlignment="Tabular"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TinyText}">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="LineHeight" Value="12" />
                        <Setter Property="FontWeight" Value="{DynamicResource MicroTextWeight}" />
                        <Setter Property="Text" Value="F&#x200A;O&#x200A;K&#x200A;U&#x200A;S" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PomodoroIsBreak}" Value="True">
                                <Setter Property="Text" Value="I&#x200A;S&#x200A;T&#x200A;I&#x200A;R&#x200A;A&#x200A;H&#x200A;A&#x200A;T" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Row="1" Text="{Binding PomodoroEndLabel}"
                       Style="{StaticResource TinyText}" FontSize="12" LineHeight="15"
                       Margin="0,4,0,0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource PrimaryButton}" Height="30" Padding="16,0" MinWidth="84"
                        Content="{Binding PomodoroPrimaryLabel}" Click="Start_Click" />
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="8,0,0,0"
                        Click="Reset_Click" ToolTip="Atur ulang">
                    <Path Data="{StaticResource IconReset}" Style="{StaticResource StrokeIcon}" Width="15" Height="15" />
                </Button>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="4,0,0,0"
                        Click="Skip_Click" ToolTip="Lewati sesi">
                    <Path Data="{StaticResource IconSkip}" Style="{StaticResource FillIcon}" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
