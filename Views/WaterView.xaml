<UserControl x:Class="NusaLite.Views.WaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             xmlns:infra="clr-namespace:NusaLite.Infrastructure"
             Width="512" Height="158">
    <UserControl.Resources>
        <infra:RatioToHeightConverter x:Key="WaterBarHeight" MaxHeight="30" />
    </UserControl.Resources>
    <Grid Margin="16,14,16,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="152" />
        </Grid.ColumnDefinitions>

        <Grid Width="96" Height="96" VerticalAlignment="Top">
            <controls:ArcRing Percent="{Binding WaterProgress}" Thickness="8" TrackBrush="#20FFFFFF"
                              Stroke="{StaticResource AquaBrush}">
                <controls:ArcRing.Effect>
                    <DropShadowEffect Color="#38D6E8" BlurRadius="18" ShadowDepth="0" Opacity="0.3" />
                </controls:ArcRing.Effect>
            </controls:ArcRing>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource IconDrop}" Fill="{StaticResource MintBrush}" Width="17" Height="17" Stretch="Uniform"
                      HorizontalAlignment="Center" />
                <TextBlock Text="{Binding WaterPercent}" Style="{StaticResource BigText}" FontSize="19"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Top">
            <TextBlock Text="Air hari ini" Style="{StaticResource TitleText}" FontSize="15" />
            <TextBlock Text="{Binding WaterAmount}" Style="{StaticResource BigText}" FontSize="19" Margin="0,2,0,0" />
            <TextBlock Text="{Binding WaterRemaining}" Style="{StaticResource CaptionText}" FontSize="10"
                       Margin="0,1,0,0" />
            <ProgressBar Style="{StaticResource SlimProgress}" Height="4" Foreground="{StaticResource AquaBrush}"
                         Value="{Binding WaterProgress, Mode=OneWay}" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                <Button Style="{StaticResource PrimaryButton}" Height="26" Padding="12,0" FontSize="10.5"
                        Click="Add_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource StrokeIcon}" Width="10" Height="10"
                              Stroke="#05060C" Margin="0,0,5,0" />
                        <TextBlock Text="250 ml" FontSize="10.5" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PillButton}" Height="26" Padding="10,0" FontSize="10"
                        Margin="7,0,0,0" Click="Reset_Click" Content="Reset" />
            </StackPanel>
            <TextBlock Text="{Binding WaterReminderText}" Style="{StaticResource TinyText}" FontSize="8.5"
                       Margin="1,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0">
            <TextBlock Text="7 hari terakhir" Style="{StaticResource TinyText}" FontSize="9"
                       HorizontalAlignment="Right" Margin="0,0,2,7" />
            <ItemsControl ItemsSource="{Binding WaterDays}" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="16" Margin="4,0,0,0">
                            <Grid Height="30" VerticalAlignment="Bottom">
                                <Border Background="#12FFFFFF" CornerRadius="3" />
                                <Border VerticalAlignment="Bottom" CornerRadius="3"
                                        Background="{StaticResource AquaBrush}"
                                        Height="{Binding Ratio, Converter={StaticResource WaterBarHeight}, ConverterParameter=3}"
                                        RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="WaterBarScale" ScaleY="0.2" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="WaterBarScale"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     To="1" Duration="0:0:0.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Label}" FontSize="8" HorizontalAlignment="Center"
                                       Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#66FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
