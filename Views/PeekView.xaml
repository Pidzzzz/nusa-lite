<UserControl x:Class="NusaLite.Views.PeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NusaLite.Controls"
             Width="336" Height="68">
    <Grid Margin="15,11,15,13">

        <!-- Volume -->
        <Grid Visibility="{Binding PeekIsVolume, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentDiagonalBrush}">
                    <Grid>
                        <Path Data="{StaticResource IconVolume}" Style="{StaticResource StrokeIcon}" Width="17" Height="17"
                              Visibility="{Binding IsMuted, Converter={StaticResource InvBoolVis}}" />
                        <Path Data="{StaticResource IconMute}" Style="{StaticResource StrokeIcon}" Width="17" Height="17"
                              Visibility="{Binding IsMuted, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeekTitle}" Style="{StaticResource TitleText}" FontSize="13.5" />
                    <TextBlock Text="{Binding PeekSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PeekValue}" Style="{StaticResource TitleText}" FontSize="15"
                           Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}" Value="{Binding PeekProgress, Mode=OneWay}"
                         Margin="49,0,0,0" />
        </Grid>

        <!-- Power -->
        <Grid Visibility="{Binding PeekIsPower, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1F6FE7D2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                    <Setter Property="Background" Value="#336FE7D2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Path Data="{StaticResource IconBattery}" Style="{StaticResource StrokeIcon}" Width="18" Height="18"
                              Stroke="{StaticResource MintBrush}" Visibility="{Binding IsCharging, Converter={StaticResource InvBoolVis}}" />
                        <Path Data="{StaticResource IconBolt}" Fill="{StaticResource MintBrush}" Width="16" Height="16" Stretch="Uniform"
                              Visibility="{Binding IsCharging, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeekTitle}" Style="{StaticResource TitleText}" FontSize="13.5" />
                    <TextBlock Text="{Binding PeekSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PeekValue}" Style="{StaticResource TitleText}" FontSize="15"
                           Foreground="{StaticResource MintBrush}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}" Foreground="{StaticResource MintBrush}"
                         Value="{Binding PeekProgress, Mode=OneWay}" Margin="49,0,0,0" />
        </Grid>

        <!-- Media -->
        <Grid Visibility="{Binding PeekIsMedia, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40">
                    <Border CornerRadius="11" Background="{StaticResource AccentDiagonalBrush}"
                            Visibility="{Binding PeekHasArtwork, Converter={StaticResource InvBoolVis}}">
                        <Path Data="{StaticResource IconMusic}" Fill="White" Width="17" Height="17" Stretch="Uniform" />
                    </Border>
                    <Border CornerRadius="11">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding PeekArtwork}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PeekTitle}" Style="{StaticResource TitleText}" FontSize="13" MaxWidth="190" />
                    <TextBlock Text="{Binding PeekSubtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               MaxWidth="190" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <controls:EqBars Width="16" Height="11" HorizontalAlignment="Right"
                                     Visibility="{Binding IsPlaying, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding PeekValue}" Style="{StaticResource TinyText}" FontSize="9"
                               Foreground="{StaticResource RoseBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}" Value="{Binding PeekProgress, Mode=OneWay}"
                         Margin="53,0,0,0" />
        </Grid>
    </Grid>
</UserControl>
