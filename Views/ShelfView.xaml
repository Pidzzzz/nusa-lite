<UserControl x:Class="NusaLite.Views.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="512" Height="158">
    <UserControl.Resources>
        <Style x:Key="ShelfCard" TargetType="Border">
            <Setter Property="Background" Value="#0EFFFFFF" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFD37A" />
                    <Setter Property="BorderBrush" Value="#38FFD37A" />
                </Trigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.02" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.02" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource MistBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="1,0,1,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Shelf" Style="{StaticResource TitleText}" FontSize="13.5" />
                <TextBlock Text="{Binding ShelfCountText}" Style="{StaticResource CaptionText}" FontSize="9.5"
                           Margin="8,0,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource PillButton}"
                    FontSize="9" Padding="9,3" Content="Bersihkan" Click="Clear_Click"
                    Visibility="{Binding HasShelfItems, Converter={StaticResource BoolVis}}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding HasShelfItems, Converter={StaticResource InvBoolVis}}"
                  Cursor="Hand" MouseLeftButtonUp="Empty_Click" Background="Transparent">
                <Rectangle x:Name="EmptyOutline" RadiusX="14" RadiusY="14" Stroke="#5CFFD37A" StrokeThickness="1.2"
                           StrokeDashArray="4 4">
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="EmptyOutline"
                                                     Storyboard.TargetProperty="StrokeDashOffset"
                                                     From="0" To="8" Duration="0:0:3.4">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconUpload}" Style="{StaticResource CardIcon}" Width="22" Height="22"
                          HorizontalAlignment="Center" Stroke="{StaticResource AmberBrush}" />
                    <TextBlock Text="Tarik file ke sini" Style="{StaticResource TitleText}" FontSize="11.5"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="atau klik untuk memilih file" Style="{StaticResource TinyText}" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                          Padding="0,0,0,3"
                          Visibility="{Binding HasShelfItems, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding ShelfItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="78" Height="93" Margin="0,0,8,0" Style="{StaticResource ShelfCard}"
                                    RenderTransformOrigin="0.5,0.5"
                                    ToolTip="{Binding Tooltip}"
                                    MouseLeftButtonUp="Card_Click"
                                    MouseRightButtonUp="Card_RightClick">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Grid Margin="8,8,8,7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="#10FFFFFF" />
                                        <Border CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Path Data="{StaticResource IconMusic}" Style="{StaticResource CardIcon}"
                                              Width="18" Height="18"
                                              Visibility="{Binding ShowFileIcon, Converter={StaticResource BoolVis}}" />
                                        <Path Data="{StaticResource IconFolder}" Style="{StaticResource CardIcon}"
                                              Width="18" Height="18"
                                              Visibility="{Binding ShowFolderIcon, Converter={StaticResource BoolVis}}" />
                                        <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="3,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Margin="1,0,0,-2">
                                            <TextBlock Text="{Binding Badge}" FontSize="6.5" FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource BaseText}"
                                               FontSize="9.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="27" Margin="0,5,0,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Row="2" Text="{Binding SizeText}" Style="{StaticResource TinyText}"
                                               FontSize="8" />

                                    <Button Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-4,0" Background="#D905060C" Click="Remove_Click"
                                            ToolTip="Hapus dari shelf">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="7.5">
                                                    <Path Data="{StaticResource IconClose}" Stroke="White"
                                                          StrokeThickness="1.5" Width="7" Height="7" Stretch="Uniform" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="#26FFD37A" BorderBrush="{StaticResource AmberBrush}" BorderThickness="1.4"
                    CornerRadius="14" IsHitTestVisible="False"
                    Visibility="{Binding ShelfDropHover, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconUpload}" Style="{StaticResource CardIcon}" Width="17" Height="17"
                          Stroke="{StaticResource AmberBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Lepaskan untuk menambahkan" Style="{StaticResource TitleText}" FontSize="11.5" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
