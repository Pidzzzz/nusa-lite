<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="VoidColor">#F3F1F8</Color>
    <Color x:Key="InkColor">#1B1726</Color>
    <Color x:Key="MistColor">#6B6478</Color>
    <Color x:Key="CyanColor">#0A6E92</Color>
    <Color x:Key="IndigoColor">#4738C0</Color>
    <Color x:Key="VioletColor">#5A37C9</Color>
    <Color x:Key="AmberColor">#6A43C4</Color>
    <Color x:Key="RoseColor">#A03BB8</Color>
    <Color x:Key="CoralColor">#7A38C4</Color>
    <Color x:Key="MintColor">#0B7C6B</Color>
    <Color x:Key="AquaColor">#0B6E7E</Color>
    <Color x:Key="LimeColor">#667D1C</Color>
    <Color x:Key="OrchidColor">#4F35C8</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource MistColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="AquaBrushSolid" Color="{StaticResource AquaColor}" />
    <SolidColorBrush x:Key="LimeBrushSolid" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="OrchidBrush" Color="{StaticResource OrchidColor}" />
    <SolidColorBrush x:Key="SoftFillBrush" Color="#12000000" />
    <SolidColorBrush x:Key="SofterFillBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="LineBrush" Color="#24000000" />

    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentDiagonalBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AquaBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource MintColor}" />
        <GradientStop Offset="1" Color="{StaticResource AquaColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmberBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource CoralColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource RoseColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LimeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource LimeColor}" />
        <GradientStop Offset="1" Color="{StaticResource AmberColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EqBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <!-- Token semantik permukaan/teks (Sesi 2a/3) -->
    <Color x:Key="IslandColor">#F3F1F8</Color>
    <Color x:Key="DotsBarColor">#99FFFFFF</Color>
    <Color x:Key="DotIdleColor">#8C000000</Color>
    <Color x:Key="PanelColor">#14000000</Color>
    <Color x:Key="CardColor">#0E000000</Color>
    <Color x:Key="FillSubtleColor">#0A000000</Color>
    <Color x:Key="FillMediumColor">#14000000</Color>
    <Color x:Key="LineStrongColor">#33000000</Color>
    <Color x:Key="FrameLineColor">#8C6A5AE0</Color>
    <Color x:Key="AccentTintColor">#26000000</Color>
    <Color x:Key="AccentHoverColor">#33000000</Color>
    <Color x:Key="AccentBorderColor">#66000000</Color>
    <Color x:Key="TrackColor">#26000000</Color>
    <Color x:Key="TextFaintColor">#1B1726</Color>
    <Color x:Key="OnPrimaryColor">#F3F1F8</Color>
    <Color x:Key="PrimaryColor">#6A43C4</Color>
    <Color x:Key="PrimaryHoverColor">#7A38C4</Color>
    <Color x:Key="PrimaryPressedColor">#4F35C8</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <Color x:Key="GlowColor">#0B6E7E</Color>
    <Color x:Key="OverlayColor">#E6F3F1F8</Color>

    <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource IslandColor}" />
    <SolidColorBrush x:Key="DotsBarBrush" Color="{StaticResource DotsBarColor}" />
    <SolidColorBrush x:Key="DotIdleBrush" Color="{StaticResource DotIdleColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="FillSubtleBrush" Color="{StaticResource FillSubtleColor}" />
    <SolidColorBrush x:Key="FillMediumBrush" Color="{StaticResource FillMediumColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="FrameLineBrush" Color="{StaticResource FrameLineColor}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorderColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

    <Color x:Key="FillGhost10Color">#10000000</Color>
    <Color x:Key="FillFaint12Color">#12000000</Color>
    <Color x:Key="LineSoft1FColor">#1F000000</Color>
    <Color x:Key="TrackSoft20Color">#20000000</Color>
    <Color x:Key="TextGhost59Color">#59000000</Color>
    <Color x:Key="TextMuted66Color">#66000000</Color>
    <Color x:Key="AccentTint12Color">#126A5AE0</Color>
    <Color x:Key="AccentTint18Color">#186A5AE0</Color>
    <Color x:Key="AccentTint1EColor">#1E6A5AE0</Color>
    <Color x:Key="AccentTint2EColor">#2E6A5AE0</Color>
    <Color x:Key="AccentTint30Color">#306A5AE0</Color>
    <Color x:Key="AccentTint38Color">#386A5AE0</Color>
    <Color x:Key="AccentTint40Color">#406A5AE0</Color>
    <Color x:Key="AccentLine5CColor">#5C6A5AE0</Color>
    <Color x:Key="AccentFill7FColor">#7F6A5AE0</Color>
    <Color x:Key="MintTint1FColor">#1F6FE7D2</Color>
    <Color x:Key="MintTint33Color">#336FE7D2</Color>
    <Color x:Key="DangerSurfaceColor">#FCE8E6</Color>

    <SolidColorBrush x:Key="FillGhost10Brush" Color="{StaticResource FillGhost10Color}" />
    <SolidColorBrush x:Key="FillFaint12Brush" Color="{StaticResource FillFaint12Color}" />
    <SolidColorBrush x:Key="LineSoft1FBrush" Color="{StaticResource LineSoft1FColor}" />
    <SolidColorBrush x:Key="TrackSoft20Brush" Color="{StaticResource TrackSoft20Color}" />
    <SolidColorBrush x:Key="TextGhost59Brush" Color="{StaticResource TextGhost59Color}" />
    <SolidColorBrush x:Key="TextMuted66Brush" Color="{StaticResource TextMuted66Color}" />
    <SolidColorBrush x:Key="AccentTint12Brush" Color="{StaticResource AccentTint12Color}" />
    <SolidColorBrush x:Key="AccentTint18Brush" Color="{StaticResource AccentTint18Color}" />
    <SolidColorBrush x:Key="AccentTint1EBrush" Color="{StaticResource AccentTint1EColor}" />
    <SolidColorBrush x:Key="AccentTint2EBrush" Color="{StaticResource AccentTint2EColor}" />
    <SolidColorBrush x:Key="AccentTint30Brush" Color="{StaticResource AccentTint30Color}" />
    <SolidColorBrush x:Key="AccentTint38Brush" Color="{StaticResource AccentTint38Color}" />
    <SolidColorBrush x:Key="AccentTint40Brush" Color="{StaticResource AccentTint40Color}" />
    <SolidColorBrush x:Key="AccentLine5CBrush" Color="{StaticResource AccentLine5CColor}" />
    <SolidColorBrush x:Key="AccentFill7FBrush" Color="{StaticResource AccentFill7FColor}" />
    <SolidColorBrush x:Key="MintTint1FBrush" Color="{StaticResource MintTint1FColor}" />
    <SolidColorBrush x:Key="MintTint33Brush" Color="{StaticResource MintTint33Color}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />

</ResourceDictionary>
