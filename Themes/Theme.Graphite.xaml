<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="VoidColor">#0E0F12</Color>
    <Color x:Key="InkColor">#F4F5F7</Color>
    <Color x:Key="MistColor">#9AA0AA</Color>
    <Color x:Key="CyanColor">#64D2FF</Color>
    <Color x:Key="IndigoColor">#6A5AE0</Color>
    <Color x:Key="VioletColor">#6D4AFF</Color>
    <Color x:Key="AmberColor">#CDB4FF</Color>
    <Color x:Key="RoseColor">#F0A6FF</Color>
    <Color x:Key="CoralColor">#B57BFF</Color>
    <Color x:Key="MintColor">#6FE7D2</Color>
    <Color x:Key="AquaColor">#38D6E8</Color>
    <Color x:Key="LimeColor">#6FE7D2</Color>
    <Color x:Key="OrchidColor">#7C5CFF</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource MistColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="AquaBrushSolid" Color="{StaticResource AquaColor}" />
    <SolidColorBrush x:Key="LimeBrushSolid" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="OrchidBrush" Color="{StaticResource OrchidColor}" />
    <SolidColorBrush x:Key="SoftFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SofterFillBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#1AFFFFFF" />

    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentDiagonalBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AquaBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource MintColor}" />
        <GradientStop Offset="1" Color="{StaticResource AquaColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmberBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource CoralColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource RoseColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LimeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource LimeColor}" />
        <GradientStop Offset="1" Color="{StaticResource AmberColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EqBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

</ResourceDictionary>
