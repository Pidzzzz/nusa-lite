<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:NusaLite.Infrastructure">

    <Color x:Key="VoidColor">#03040A</Color>
    <Color x:Key="InkColor">#ECEFF7</Color>
    <Color x:Key="MistColor">#8C94A8</Color>
    <Color x:Key="CyanColor">#64D2FF</Color>
    <Color x:Key="IndigoColor">#0A84FF</Color>
    <Color x:Key="VioletColor">#5E5CE6</Color>
    <Color x:Key="AmberColor">#FFD37A</Color>
    <Color x:Key="RoseColor">#FF7A9A</Color>
    <Color x:Key="CoralColor">#FF8A5C</Color>
    <Color x:Key="MintColor">#6FE7D2</Color>
    <Color x:Key="AquaColor">#38D6E8</Color>
    <Color x:Key="LimeColor">#C7F36B</Color>
    <Color x:Key="OrchidColor">#9B7BFF</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource MistColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="AquaBrushSolid" Color="{StaticResource AquaColor}" />
    <SolidColorBrush x:Key="LimeBrushSolid" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="OrchidBrush" Color="{StaticResource OrchidColor}" />
    <SolidColorBrush x:Key="SoftFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SofterFillBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#1AFFFFFF" />

    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="0.52" Color="{StaticResource RoseColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentDiagonalBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="0.52" Color="{StaticResource RoseColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AquaBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource MintColor}" />
        <GradientStop Offset="0.52" Color="{StaticResource AquaColor}" />
        <GradientStop Offset="1" Color="#5B8CFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmberBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource CoralColor}" />
        <GradientStop Offset="0.55" Color="#FF5A6E" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="1" Color="#FFB36B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LimeBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource LimeColor}" />
        <GradientStop Offset="1" Color="{StaticResource AmberColor}" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EqBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource AmberColor}" />
        <GradientStop Offset="0.5" Color="{StaticResource RoseColor}" />
        <GradientStop Offset="1" Color="{StaticResource OrchidColor}" />
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">SF Pro Display, Segoe UI Variable Display, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="UiFont">SF Pro Text, SF Pro Display, Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BigText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
    </Style>

    <Style x:Key="TinyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1EFFD37A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#30FFD37A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFD37A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#38FFD37A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#05060C" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFF1DF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#F3DEC4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <infra:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
    <infra:BoolToOpacityConverter x:Key="BoolOpacity" />
    <infra:EmptyToVisibilityConverter x:Key="EmptyVis" />
    <infra:EmptyToVisibilityConverter x:Key="EmptyVisInvert" Invert="True" />
    <infra:RatioToHeightConverter x:Key="RatioHeight" MaxHeight="34" />

    <!-- Icons -->
    <Geometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</Geometry>
    <Geometry x:Key="IconPause">M7,5 L10.5,5 L10.5,19 L7,19 Z M13.5,5 L17,5 L17,19 L13.5,19 Z</Geometry>
    <Geometry x:Key="IconPrev">M7,5 L9.5,5 L9.5,19 L7,19 Z M19,5 L9.5,12 L19,19 Z</Geometry>
    <Geometry x:Key="IconNext">M17,5 L14.5,5 L14.5,19 L17,19 Z M5,5 L14.5,12 L5,19 Z</Geometry>
    <Geometry x:Key="IconVolume">M4,9.5 H8 L13,5.5 V18.5 L8,14.5 H4 Z M16,9.5 C17.2,10.5 17.2,13.5 16,14.5 M18.6,7 C21,9.5 21,14.5 18.6,17</Geometry>
    <Geometry x:Key="IconMute">M4,9.5 H8 L13,5.5 V18.5 L8,14.5 H4 Z M16.5,9.5 L21,14 M21,9.5 L16.5,14</Geometry>
    <Geometry x:Key="IconBolt">M13,2 L5,13.5 H11 L10,22 L19,10 H12 Z</Geometry>
    <Geometry x:Key="IconBattery">M3,7.5 H17 V16.5 H3 Z M19,10.5 H21 V13.5 H19</Geometry>
    <Geometry x:Key="IconDrop">M12,3 C12,3 5.5,10.5 5.5,15 A6.5,6.5 0 0 0 18.5,15 C18.5,10.5 12,3 12,3 Z</Geometry>
    <Geometry x:Key="IconMusic">M9,4 L20,2 V13.5 A3,3 0 1 1 17.5,10.6 V7.2 L11.5,8.4 V17 A3,3 0 1 1 9,14.1 Z</Geometry>
    <Geometry x:Key="IconFolder">M3,6 H9.5 L11.5,8 H21 V19 H3 Z</Geometry>
    <Geometry x:Key="IconUpload">M12,16 V5 M7.5,9 L12,4.5 L16.5,9 M4,15 V20 H20 V15</Geometry>
    <Geometry x:Key="IconClose">M7,7 L17,17 M17,7 L7,17</Geometry>
    <Geometry x:Key="IconTrash">M5,7 H19 M9,7 V5 H15 V7 M7,7 L8,20 H16 L17,7 M10,10 V17 M14,10 V17</Geometry>
    <Geometry x:Key="IconReset">M4,12 A8,8 0 1 1 7,17.7 M4,6 V12 H10</Geometry>
    <Geometry x:Key="IconSkip">M5,5 L14,12 L5,19 Z M17,5 V19</Geometry>
    <Geometry x:Key="IconClock">M12,4 A8,8 0 1 1 11.99,4 M12,8 V12.5 L15,14.5</Geometry>
    <Geometry x:Key="IconPin">M9,3 H15 L14,9 L18,13 V15 H6 V13 L10,9 Z M12,15 V21</Geometry>
    <Geometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</Geometry>
    <Geometry x:Key="IconLyrics">M5,6 H19 M5,10 H19 M5,14 H14 M5,18 H10</Geometry>
    <Geometry x:Key="IconChevronLeft">M14,6 L8,12 L14,18</Geometry>
    <Geometry x:Key="IconChevronRight">M10,6 L16,12 L10,18</Geometry>
    <Geometry x:Key="IconMinus">M6,12 H18</Geometry>
    <Geometry x:Key="IconPlus">M12,6 V18 M6,12 H18</Geometry>

    <Style x:Key="StrokeIcon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style x:Key="FillIcon" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource InkBrush}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFF1DF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#F3DEC4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimSlider" TargetType="Slider">
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="3" VerticalAlignment="Center" CornerRadius="2" Background="#33FFFFFF" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="10" Height="10">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
